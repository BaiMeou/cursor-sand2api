# Copy to .env and export it yourself (dotenv is not loaded by server.js).
# .env is gitignored. Never put a Cursor JWT or crsr_ key in this file.

# --- process ---
HOST=127.0.0.1
PORT=13000
# Shared secret for /v1/* and /health/detail. Empty is allowed only on loopback.
# A non-loopback bind exits if this is unset.
API_KEY=changeme
# on | off. Unset = on for loopback, off for any other bind.
# Do not set WEB_UI=on with HOST=0.0.0.0.
# WEB_UI=off
# CORS_ORIGIN=*
# CORS_ORIGIN=http://127.0.0.1:13000
TOKEN_FILE=./token.json
MAX_BODY_SIZE=64mb

# --- Cursor sand client ---
# CURSOR_BASE_URL=https://api2.cursor.sh
# CURSOR_CLIENT_VERSION=3.17.21
# CURSOR_CLIENT_TYPE=sand
# SAND_BOX_NAMESPACE=prod
# CURSOR_USER_AGENT=connect-es/1.6.1
# CURSOR_ACCEPT_GZIP=false
# CURSOR_GHOST_MODE=
# CURSOR_ALLOWED_NATIVE_TOOLS=
DEFAULT_MODEL=kimi-k3

# --- timeouts (ms) ---
# REQUEST_TIMEOUT=300000
# IDLE_TIMEOUT=120000
# OUTPUT_TIMEOUT=240000

# --- pool cooldowns (ms). 0 = do not bench the credential ---
TOKEN_COOLDOWN_MS=0
TOKEN_AUTH_COOLDOWN_MS=0
TOKEN_RATE_LIMIT_COOLDOWN_MS=0

# --- models / debug ---
# MODEL_CACHE_TTL_MS=900000
# MODEL_ERROR_CACHE_TTL_MS=30000
# MODEL_PARAMETERS=false
# DEBUG_TOOL_TRACE=false
# DEBUG_PROMPT=false

# --- tools ---
TOOL_MODE=client
# WORKSPACE_DIR=./workspace
# ENABLE_SHELL=false
# ENABLE_FETCH=true
# SHELL_TIMEOUT_MS=30000
# DECLARE_MCP_TOOLS=false
# CONVERSATION_HISTORY=false
# SYSTEM_AS_HISTORY=true
# CONTINUATION_PROMPT=Continue, using the tool results above.
# WEB_SEARCH=false
# Named-model sand does not silently prefer a Grok Bot Plan account.
PREFER_GROK_BOT_PLAN=false
